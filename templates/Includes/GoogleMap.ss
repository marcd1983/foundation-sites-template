<% if $MapEmbedURL %>

  <div class="responsive-embed" style="margin:0;padding-bottom:112%;">
    <iframe
      src="$MapEmbedURL.ATT"
      width="600" height="450" style="border:0;" allowfullscreen=""
      loading="lazy" referrerpolicy="no-referrer-when-downgrade">
      </iframe>
  </div>

<% end_if %>