<div id="MobileMastHead_Section" class="header-container shadow p-6 hide-for-large">
	<div class="grid-container">
	<div class="grid-x padding-x padding-y align-justify align-middle " style="gap:40px">
		<div class="cell auto">
			<a href="/">
				<img src="$SiteConfig.SiteLogo.URL" width="$SiteConfig.SiteLogo.Width" height="$SiteConfig.SiteLogo.Height" alt="$SiteConfig.Title" title="$SiteConfig.Title">
			</a>
		</div>
		<div class="cell shrink">
			<div class="button-group small" style="margin:0;gap:3px;">
				<a class="slide-out-btn button small" id="slideMenu03">
					<svg class="ico-location_on-dark ico-white"><use xlink:href="#location_on"></use></svg>
				</a>
				<a class="slide-out-btn button small" id="slideMenu01">
					<svg class="ico-location_on-dark ico-white"><use xlink:href="#menu"></use></svg>
				</a>
			</div>
		</div>	
	</div>
	</div>
	<div class="grid-container">
	<div class="grid-x padding-x padding-y">
		<div class="cell">
			<a href="/used-equipment" class="button secondary expanded">View Inventory</a>
		</div>
	</div>
	</div>
</div>	

